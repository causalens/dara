{
  "name": "@darajs/ui-hierarchy-viewer",
  "version": "1.29.7",
  "description": "Hierarchy Viewer for the Dara UI framework",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "jsnext:main": "dist/index.js",
  "scripts": {
    "build": "rimraf dist && tsc",
    "prepare-dev": "tsc",
    "lint": "oxlint --type-aware --type-check src && stylelint './src/**/*.tsx'",
    "format": "oxfmt src --write",
    "format:check": "oxfmt src --check",
    "lint:fix": "oxlint --type-aware --type-check --fix src && stylelint './src/**/*.tsx' --fix",
    "test-watch": "vitest"
  },
  "author": "Krzysztof Bielikowicz <krzysztof@causalens.com>",
  "license": "Apache-2.0",
  "devDependencies": {
    "@darajs/oxfmt-config": "1.29.7",
    "@darajs/oxlint-config": "1.29.7",
    "@darajs/stylelint-config": "1.29.7",
    "@types/d3": "^6.2.0",
    "@types/react": "^18.0",
    "@types/styled-components": "^5.1.26",
    "@typescript/native": "npm:typescript@^7.0.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "rimraf": "^3.0.2",
    "stylelint": "^17.14.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@darajs/styled-components": "1.29.7",
    "@darajs/ui-utils": "1.29.7",
    "d3": "6.2.0",
    "react": "^18.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "timeout": 60000
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/causalens/dara.git",
    "directory": "packages/ui-hierarchy-viewer"
  }
}
