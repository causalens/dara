{
  "name": "@darajs/ui-notifications",
  "version": "1.29.5",
  "description": "Notification system for the Dara UI Framework",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "jsnext:main": "dist/index.js",
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "prepare-dev": "tsc -p tsconfig.build.json",
    "lint": "oxlint --type-aware --type-check src && stylelint './src/**/*.tsx'",
    "format": "oxfmt src --write",
    "format:check": "oxfmt src --check",
    "lint:fix": "oxlint --type-aware --type-check --fix src && stylelint './src/**/*.tsx' --fix",
    "test-watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "author": "Krzysztof Bielikowicz <krzysztof@causalens.com>",
  "license": "Apache-2.0",
  "devDependencies": {
    "@darajs/oxfmt-config": "1.29.5",
    "@darajs/oxlint-config": "1.29.5",
    "@darajs/stylelint-config": "1.29.5",
    "@storybook/react-vite": "^10.5.3",
    "@types/lodash": "^4.14.155",
    "@types/node": "^24.0.0",
    "@types/react": "^18.0",
    "@types/styled-components": "^5.1.26",
    "@typescript/native": "npm:typescript@^7.0.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "rimraf": "^3.0.2",
    "storybook": "^10.5.3",
    "stylelint": "^17.14.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@darajs/styled-components": "1.29.5",
    "@darajs/ui-icons": "1.29.5",
    "@darajs/ui-utils": "1.29.5",
    "lodash": "4.18.1",
    "polished": "^4.1.1",
    "react": "^18.0",
    "rxjs": "^7.0.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "timeout": 60000
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/causalens/dara.git",
    "directory": "packages/ui-notifications"
  }
}
