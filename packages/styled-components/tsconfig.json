{
    "exclude": ["**/*.spec.tsx", "dist/**"],
    "compilerOptions": {
        "declaration": true,
        "esModuleInterop": true,
        "jsx": "react-jsx",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noImplicitAny": true,
        "noUncheckedSideEffectImports": false,
        "outDir": "./dist/",
        "rootDir": "./src/",
        "skipLibCheck": true,
        "sourceMap": true,
        "strict": false,
        "target": "es2015",
    }
}
