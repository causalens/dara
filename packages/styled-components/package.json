{
  "name": "@darajs/styled-components",
  "version": "1.29.4",
  "description": "CL wrapper around styled components so everything gets the same instance",
  "main": "dist/index.js",
  "license": "Apache-2.0",
  "scripts": {
    "build": "rimraf dist && tsc",
    "prepare-dev": "tsc",
    "lint": "eslint src --ext .tsx --max-warnings 0 && stylelint './src/**/*.tsx'",
    "format": "oxfmt src --write",
    "format:check": "oxfmt src --check",
    "lint:fix": "eslint src --ext .tsx --max-warnings 0 --fix && stylelint './src/**/*.tsx' --fix"
  },
  "devDependencies": {
    "@darajs/eslint-config": "1.29.4",
    "@darajs/oxfmt-config": "1.29.4",
    "@darajs/stylelint-config": "1.29.4",
    "@types/styled-components": "^5.1.26",
    "@typescript/native": "npm:typescript@^7.0.0",
    "eslint": "^8.57.1",
    "oxfmt": "^0.60.0",
    "rimraf": "^3.0.2",
    "stylelint": "^15.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "dependencies": {
    "polished": "^4.1.1",
    "styled-components": "^5.3.10"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "timeout": 60000
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/causalens/dara.git",
    "directory": "packages/styled-components"
  }
}
