{
  "name": "@darajs/ui-widgets",
  "version": "1.29.8",
  "description": "The UI widgets built on top of UI components",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "jsnext:main": "dist/index.js",
  "scripts": {
    "build": "rimraf dist && tsc",
    "prepare-dev": "tsc",
    "lint": "oxlint --type-aware --type-check src && stylelint './src/**/*.tsx'",
    "format": "oxfmt src --write",
    "format:check": "oxfmt src --check",
    "lint:fix": "oxlint --type-aware --type-check --fix src && stylelint './src/**/*.tsx' --fix",
    "test-watch": "vitest"
  },
  "devDependencies": {
    "@darajs/oxfmt-config": "1.29.8",
    "@darajs/oxlint-config": "1.29.8",
    "@darajs/stylelint-config": "1.29.8",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.2.1",
    "@types/styled-components": "^5.1.26",
    "@typescript/native": "npm:typescript@^7.0.0",
    "jsdom": "^27.4.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "rimraf": "^3.0.2",
    "stylelint": "^17.14.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@darajs/styled-components": "1.29.8",
    "@darajs/ui-components": "1.29.8",
    "@darajs/ui-icons": "1.29.8",
    "@darajs/ui-utils": "1.29.8",
    "lodash": "4.18.1",
    "nanoid": "^3.3.18",
    "react": "^18.0",
    "react-dom": "^18.0"
  },
  "files": [
    "dist"
  ],
  "author": "Krzysztof Bielikowicz <krzysztof@causalens.com>",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "timeout": 60000
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/causalens/dara.git",
    "directory": "packages/ui-widgets"
  }
}
