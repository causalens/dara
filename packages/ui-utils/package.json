{
  "name": "@darajs/ui-utils",
  "version": "1.30.0",
  "description": "General utilities for the Dara UI framework",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "jsnext:main": "dist/index.js",
  "scripts": {
    "build": "rimraf dist && tsc && vite build",
    "prepare-dev": "tsc && vite build",
    "lint": "oxlint --type-aware --type-check src && stylelint './src/**/*.tsx'",
    "format": "oxfmt src --write",
    "format:check": "oxfmt src --check",
    "lint:fix": "oxlint --type-aware --type-check --fix src && stylelint './src/**/*.tsx' --fix",
    "test-watch": "vitest"
  },
  "author": "Krzysztof Bielikowicz <krzysztof@causalens.com>",
  "license": "Apache-2.0",
  "devDependencies": {
    "@darajs/oxfmt-config": "1.30.0",
    "@darajs/oxlint-config": "1.30.0",
    "@darajs/stylelint-config": "1.30.0",
    "@types/lodash": "^4.14.155",
    "@types/react": "^18.0",
    "@typescript/native": "npm:typescript@^7.0.0",
    "d3-color": "^3.1.0",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "rimraf": "^3.0.2",
    "stylelint": "^17.14.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "8.1.6",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "lodash": "4.18.1",
    "nanoid": "^3.3.18",
    "react": "^18.0",
    "rxjs": "^7.0.0",
    "tinykeys": "^3.0.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "timeout": 60000
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/causalens/dara.git",
    "directory": "packages/ui-utils"
  }
}
