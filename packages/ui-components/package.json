{
  "name": "@darajs/ui-components",
  "version": "1.29.6",
  "description": "The core React UI kit for Dara",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "jsnext:main": "dist/index.js",
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "prepare-dev": "tsc -p tsconfig.build.json",
    "format": "oxfmt src --write",
    "format:check": "oxfmt src --check",
    "lint": "oxlint --type-aware --type-check src && stylelint './src/**/*.tsx'",
    "lint:fix": "oxlint --type-aware --type-check --fix src && stylelint './src/**/*.tsx' --fix",
    "test-watch": "vitest",
    "test": "vitest --run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "author": "Krzysztof Bielikowicz <krzysztof@causalens.com>",
  "license": "Apache-2.0",
  "devDependencies": {
    "@darajs/oxfmt-config": "1.29.6",
    "@darajs/oxlint-config": "1.29.6",
    "@darajs/stylelint-config": "1.29.6",
    "@storybook/react-vite": "^10.5.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.2.1",
    "@types/d3-array": "^3.2.1",
    "@types/lodash": "^4.14.155",
    "@types/node": "^24.0.0",
    "@types/react": "^18.0",
    "@types/react-collapse": "^5.0.1",
    "@types/react-datepicker": "^4.0.0",
    "@types/react-dom": "^18.0",
    "@types/react-table": "^7.0.19",
    "@types/react-virtualized-auto-sizer": "1.0.4",
    "@types/react-window": "^1.8.2",
    "@types/styled-components": "^5.1.26",
    "@typescript/native": "npm:typescript@^7.0.0",
    "@vitejs/plugin-react": "6.0.4",
    "jsdom": "^27.4.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "rimraf": "^3.0.2",
    "storybook": "^10.5.3",
    "stylelint": "^17.14.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@darajs/styled-components": "1.29.6",
    "@darajs/ui-icons": "1.29.6",
    "@darajs/ui-utils": "1.29.6",
    "@floating-ui/react": "^0.26.12",
    "@fortawesome/free-regular-svg-icons": "~6.4.0",
    "@fortawesome/free-solid-svg-icons": "~6.4.0",
    "@fortawesome/react-fontawesome": "0.2.2",
    "@headlessui-float/react": "^0.15.0",
    "@headlessui/react": "^1.0.0",
    "d3-array": "^3.2.4",
    "date-fns": "2.30.0",
    "downshift": "^7.0.0",
    "lodash": "4.18.1",
    "memoize-one": "^6.0.0",
    "nanoid": "^3.3.8",
    "polished": "3.6.4",
    "prism-react-renderer": "^1.2.0",
    "react": "^18.0",
    "react-aria-components": "^1.9.0",
    "react-collapse": "^5.1.1",
    "react-datepicker": "4.8.0",
    "react-dom": "^18.0",
    "react-dropzone": "11.0.1",
    "react-markdown": "^9.0.1",
    "react-table": "7.7.0",
    "react-table-sticky": "^1.1.3",
    "react-virtualized-auto-sizer": "1.0.6",
    "react-window": "1.8.10",
    "remark-gfm": "^4.0.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "timeout": 60000
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/causalens/dara.git",
    "directory": "packages/ui-components"
  }
}
