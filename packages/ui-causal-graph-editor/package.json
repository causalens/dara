{
  "name": "@darajs/ui-causal-graph-editor",
  "version": "1.29.7",
  "description": "CausalGraph editor for the Dara UI framework",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "type": "module",
  "jsnext:main": "dist/index.js",
  "scripts": {
    "build": "rimraf dist && vite build && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "prepare-dev": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "lint": "oxlint --type-aware --type-check src tests && stylelint './src/**/*.{ts,tsx}'",
    "format": "oxfmt src --write",
    "format:check": "oxfmt src --check",
    "lint:fix": "oxlint --type-aware --type-check --fix src tests && stylelint './src/**/*.{ts,tsx}' --fix",
    "test-watch": "vitest",
    "test": "vitest --run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "author": "Krzysztof Bielikowicz <krzysztof@causalens.com>",
  "license": "Apache-2.0",
  "devDependencies": {
    "@darajs/oxfmt-config": "1.29.7",
    "@darajs/oxlint-config": "1.29.7",
    "@darajs/stylelint-config": "1.29.7",
    "@storybook/react-vite": "^10.5.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/cytoscape": "^3.19.9",
    "@types/cytoscape-fcose": "^2.2.0",
    "@types/d3": "^6.2.0",
    "@types/fontfaceobserver": "^2.1.0",
    "@types/lodash": "^4.14.155",
    "@types/node": "^24.0.0",
    "@types/react": "^18.0",
    "@types/styled-components": "^5.1.26",
    "@types/svg-path-parser": "^1.1.3",
    "@typescript/native": "npm:typescript@^7.0.0",
    "@vitejs/plugin-react": "6.0.4",
    "graphology-generators": "^0.11.2",
    "jsdom": "^27.4.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pixi-filters": "~6.0.4",
    "pixi-viewport": "5.0.3",
    "pixi.js": "~8.5.0",
    "rimraf": "^3.0.2",
    "storybook": "^10.5.3",
    "stylelint": "^17.14.1",
    "tsc-alias": "^1.8.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@darajs/styled-components": "1.29.7",
    "@darajs/ui-components": "1.29.7",
    "@darajs/ui-icons": "1.29.7",
    "@darajs/ui-notifications": "1.29.7",
    "@darajs/ui-utils": "1.29.7",
    "@darajs/ui-widgets": "1.29.7",
    "comlink": "^4.4.1",
    "cytoscape": "^3.23.0",
    "cytoscape-fcose": "^2.2.0",
    "d3": "6.2.0",
    "d3-dag": "^1.1.0",
    "d3-scale": "3.2.1",
    "eventemitter3": "^5.0.1",
    "fontfaceobserver": "^2.3.0",
    "graphology": "^0.25.1",
    "graphology-dag": "^0.2.0",
    "graphology-layout": "^0.6.1",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-layout-noverlap": "^0.4.2",
    "graphology-types": "^0.24.7",
    "immer": "^10.0.4",
    "lodash": "4.18.1",
    "nanoid": "^3.3.17",
    "polished": "^4.1.1",
    "react": "^18.0",
    "react-dnd": "^14.0.5",
    "react-dnd-html5-backend": "^14.1.0",
    "svg-path-parser": "^1.1.0",
    "use-immer": "^0.9.0",
    "vis-data": "^7.1.2",
    "vis-network": "^9.1.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "timeout": 60000
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/causalens/dara.git",
    "directory": "packages/ui-causal-graph-editor"
  }
}
