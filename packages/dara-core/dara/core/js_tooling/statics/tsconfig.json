{
    "exclude": ["**/*.spec.tsx", "tests/**", "**/*.template.tsx"],
    "compilerOptions": {
        "declaration": true,
        "esModuleInterop": true,
        "jsx": "react",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noImplicitAny": true,
        "noUncheckedSideEffectImports": false,
        "outDir": ".",
        "preserveSymlinks": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "strict": true,
        "target": "es2015",
    }
}
