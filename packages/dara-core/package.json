  "scripts": {
    "build": "rimraf dist && mkdir -p dist && tsc && cp -R js/assets dist/ && cp js/index.css dist/ && tsc-alias",
    "prepare-dev": "mkdir -p dist && tsc && cp -R js/assets dist/ && cp js/index.css dist/ && tsc-alias",
    "build-dev": "mkdir -p dist && cp js/index.css dist/ && cp -R js/assets dist/ && tsc && (concurrently \"tsc -w\" \"tsc-alias -w\")",
    "clean": "rimraf api assets components shared types *.js.map *.d.ts '!(*.config).js' *.css",
    "cypress:open": "cypress open --e2e",
    "lint": "oxlint --type-aware --type-check js tests cypress && stylelint './js/**/*.tsx'",
    "format": "oxfmt js --write",
    "format:check": "oxfmt js --check",
    "lint:fix": "oxlint --type-aware --type-check --fix js tests cypress && stylelint --fix './js/**/*.tsx'",
    "package": "yarn build && yarn publish --no-git-tag-version",
    "test-watch": "vitest",
    "test": "vitest --run",
    "test:e2e": "uv run --locked python cypress/run.py"
  },
